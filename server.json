{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.arielonoriaga/iron-stack",
  "title": "Iron Stack (Iron Memory) — Zero-Cloud SQLite FTS5 Memory Hub",
  "description": "Zero-cloud SQLite FTS5 stdio MCP memory hub, cross-repo system graph and local Second Brain UI.",
  "version": "0.4.2",
  "websiteUrl": "https://iron.huggian.com",
  "repository": {
    "url": "https://github.com/arielonoriaga/iron-stack",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "iron-stack",
      "version": "0.4.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
