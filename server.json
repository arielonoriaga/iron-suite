{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.arielonoriaga/iron-suite",
  "title": "Iron Suite — Zero-Cloud SQLite FTS5 Memory Hub",
  "description": "Zero-cloud SQLite FTS5 stdio MCP memory hub with byte budgets, drift audit & local Second Brain UI.",
  "version": "0.3.1",
  "websiteUrl": "https://github.com/arielonoriaga/iron-suite",
  "repository": {
    "url": "https://github.com/arielonoriaga/iron-suite",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "iron-suite",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
