{
  "repos_root": "/home/you/Projects",
  "services": {
    "shop-api": {
      "repo": "shop",
      "root": "backend",
      "stack": "axum"
    },
    "shop-web": {
      "repo": "shop",
      "root": "frontend",
      "stack": "spa",
      "client": "src/lib/api.ts",
      "base": "shop-api",
      "base_prefix": "/api/v1"
    },
    "worker-api": {
      "repo": "worker",
      "root": "",
      "stack": "axum",
      "entry": "src/bin/api.rs"
    }
  },
  "env": {
    "SHOP_API_URL": "shop-api"
  },
  "clients": {
    "worker:src/clients/shop.rs": "shop-api"
  },
  "prefixes": {},
  "external": [
    "worker:src/providers/**"
  ],
  "verified_pairs_file": "~/.claude/verdicts/graph-pairs.jsonl"
}
